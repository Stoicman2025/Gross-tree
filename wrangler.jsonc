{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gross-tree",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-tree-db",
      "database_id": "3384397a-4722-4f19-85fb-02e1bfd87012"
    }
  ]
}
